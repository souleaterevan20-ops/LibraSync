# ============================================================
# LibraSync — PRODUCTION .env template
# Copy this to `.env` on your production server and fill in the
# blanks. Do NOT reuse your local development .env as-is.
# See DEPLOYMENT.md for the full explanation of each setting.
# ============================================================

APP_NAME=LibraSync
APP_ENV=production
APP_KEY=                      # fill in by running: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-real-domain-here.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ---- Database: MySQL (switched from local SQLite) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1              # or your host's DB hostname
DB_PORT=3306
DB_DATABASE=librasync           # the database name your host/XAMPP gave you
DB_USERNAME=                    # your MySQL username
DB_PASSWORD=                    # your MySQL password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---- Email (for real due-date / clearance / notification emails) ----
# If you don't have a mail provider yet, MAIL_MAILER=log will just write
# emails to storage/logs/laravel.log instead of sending them — fine for
# a demo, but you'll want real SMTP credentials before real users rely
# on email reminders.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="library@spap.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
